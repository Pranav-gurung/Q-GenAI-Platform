# Copy to .env and adjust. Never commit .env. Placeholders only.

# --- runtime ---
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=console                 # console (human readable) | json (for log shippers)

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SERVE_FRONTEND=true
# Optional shared key for write endpoints (X-API-Key header). Empty = auth disabled (dev only).
API_KEY=

# --- database ---
# PostgreSQL (recommended / docker compose):
DATABASE_URL=postgresql+psycopg://qgenai:change-me@localhost:5432/qgenai
# Zero-setup local alternative:
# DATABASE_URL=sqlite:///./data/qgenai-dev.db
SEED_SAMPLE_DATA=true              # load data/samples/dark_store_sample.json on startup if tables are empty

# --- image storage ---
STORAGE_BACKEND=local              # local (s3 / azure / gcs: future)
STORAGE_PATH=data/raw/images
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=jpeg,png,webp
MAX_IMAGE_PIXELS=40000000          # decompression-bomb guard

# --- pipeline modules (only "stub" exists in Part 1) ---
QUALITY_GATE_ENGINE=stub
CV_ENGINE=stub
DECISION_ENGINE=stub
PIPELINE_ANALYSIS_ENGINE=stub
RCA_ENGINE=stub
ACTION_ENGINE=stub
MODEL_PATH=models/                 # used from Part 2 (CV weights); unused in Part 1

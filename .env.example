# Copy to .env and adjust. Never commit .env. Placeholders only.

# --- runtime ---
ENVIRONMENT=development            # development | test | production
LOG_LEVEL=INFO
LOG_FORMAT=console                 # console (human readable) | json (for log shippers)

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_PREFIX=/api
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
SERVE_FRONTEND=true
# Optional shared key for write endpoints (X-API-Key header). Empty = auth disabled (dev only; a warning is
# logged in production). Never commit a real value.
API_KEY=
RATE_LIMIT_PER_MINUTE=60           # per client, for image upload (CV) and GET /rca (LLM); 0 disables; in-process only

# --- database ---
# PostgreSQL (recommended / docker compose):
DATABASE_URL=postgresql+psycopg://qgenai:change-me@localhost:5432/qgenai
# Zero-setup local alternative:
# DATABASE_URL=sqlite:///./data/qgenai-dev.db
SEED_SAMPLE_DATA=true              # load data/samples/dark_store_sample.json on startup if tables are empty

# --- image storage ---
STORAGE_BACKEND=local              # local (s3 / azure / gcs: future)
STORAGE_PATH=data/raw/images
MAX_UPLOAD_MB=10
ALLOWED_IMAGE_TYPES=jpeg,png,webp
MAX_IMAGE_PIXELS=40000000          # decompression-bomb guard

# --- pipeline modules ---
QUALITY_GATE_ENGINE=stub           # stub | basic (blur / resolution / brightness checks)
CV_ENGINE=stub                     # stub | yolov8 (needs: pip install -e ".[cv]" and a model artifact)
DECISION_ENGINE=stub               # stub | rules (deterministic PASS / FAIL / REVIEW)
PIPELINE_ANALYSIS_ENGINE=stub      # stub | deterministic (fulfillment stage history + first-defect attribution)
RCA_ENGINE=stub                    # stub | genai (GenAI root-cause analysis, needs the LLM below)
ACTION_ENGINE=stub                 # stub | rca   (corrective actions taken from the GenAI RCA)

# --- GenAI RCA (LLM) ---  the app starts and all deterministic results work with the LLM disabled
LLM_ENABLED=false
LLM_PROVIDER=anthropic             # anthropic | mock (deterministic test double; refused in production)
LLM_MODEL=claude-opus-5-5
LLM_API_KEY=                       # or ANTHROPIC_API_KEY; never commit, never logged or returned
LLM_MAX_TOKENS=8000                # includes the model's adaptive thinking
LLM_TIMEOUT_SECONDS=30
LLM_EFFORT=low                     # low | medium | high | xhigh | max (latency vs depth)
LLM_REFUSAL_FALLBACK=true          # Anthropic server-side fallback if a safety classifier declines
# LLM_TEMPERATURE=                 # not sent to Anthropic: the API rejects sampling parameters

# --- RAG / SOP intelligence (Part 5) ---
RAG_ENABLED=false                  # true: ground RCA actions in knowledge/ (build index: python -m backend.rag.ingest)
RAG_KNOWLEDGE_PATH=knowledge       # DEMO / SYNTHETIC SOPs (Markdown + YAML front matter)
RAG_INDEX_PATH=data/rag/index      # local vector store (vectors.npy + chunks.json + manifest.json), git-ignored
RAG_EMBEDDING_PROVIDER=hashing     # hashing (offline, numpy only) | sentence_transformers (pip install -e '.[rag-neural]')
RAG_EMBEDDING_MODEL=hashing-lexical-v1   # e.g. sentence-transformers/all-MiniLM-L6-v2 for sentence_transformers
RAG_EMBEDDING_DIM=2048             # hashing provider only
RAG_TOP_K=5                        # sources per defect
RAG_MIN_SIMILARITY=0.15            # cosine gate; calibrated on the demo corpus (relevant >= 0.17, unrelated <= 0.07)
RAG_MAX_CHUNK_CHARS=1200

# --- computer vision (CV_ENGINE=yolov8) ---
CV_MODEL_PATH=artifacts/cv/qgenai-yolov8n-synthetic-v1/model/best.pt
# CV_MODEL_VERSION=                # override; default from the artifact's metadata.json
CV_DEVICE=auto                     # auto (cuda if available, else cpu) | cpu | cuda | cuda:N  (cuda without GPU = error)
CV_CONFIDENCE_THRESHOLD=0.35       # lower: fewer missed defects, more false alarms / reviews
CV_IOU_THRESHOLD=0.5               # NMS overlap threshold
# CV_IMAGE_SIZE=                   # default: the size the model was trained at
CV_MAX_DETECTIONS=50
CV_TAXONOMY_PATH=ml/cv/taxonomy.yaml
CV_SEVERITY_LARGE_AREA_RATIO=0.20  # box >= 20% of image -> severity +1 level

# --- image quality gate (QUALITY_GATE_ENGINE=basic) ---
CV_MIN_IMAGE_WIDTH=128
CV_MIN_IMAGE_HEIGHT=128
CV_MAX_ASPECT_RATIO=6
CV_BLUR_THRESHOLD=15               # variance of Laplacian at 512 px long side
CV_MIN_BRIGHTNESS=20
CV_MAX_BRIGHTNESS=240

# --- decision rules (DECISION_ENGINE=rules) ---
DECISION_FAIL_MIN_SEVERITY=HIGH
DECISION_FAIL_MIN_CONFIDENCE=0.5
DECISION_AUTO_PASS=false           # true: PASS when CV detects nothing (only if model coverage is trusted)

# Copy to .env (never commit .env). Placeholders only - no real values here.

# --- paths ---
RCA_APPROVED_DOCS_DIR=documents/approved
RCA_INDEX_DIR=data/rag_index

# --- retrieval ---
RCA_EMBEDDING_BACKEND=hashing            # hashing (offline lexical baseline) | sentence_transformers
RCA_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RCA_VECTOR_STORE=json                    # json | chroma
RCA_CHUNK_SIZE=900
RCA_CHUNK_OVERLAP=150
RCA_TOP_K=5
# RCA_MIN_SCORE=0.30                     # calibrate on YOUR corpus; defaults: hashing 0.08, sentence_transformers 0.30
RCA_MIN_EVIDENCE_PASSAGES=1
RCA_REQUIRE_CLASS_TERM=true              # passage must mention the defect class (or alias) to count as evidence
# RCA_CLASS_ALIASES={"scratch": ["abrasion", "scoring"]}
RCA_ALLOWED_ACCESS_LEVELS=public,internal
RCA_MIN_PAGE_CHARS=40

# --- request validation ---
RCA_MAX_DEFECTS=20
# Keep in sync with Module A's class map:
RCA_SUPPORTED_CLASSES=scratch,crack,dent,corrosion
# RCA_CLASS_MAP_PATH=data/annotations/<version>/canonical_train.json

# --- LLM (generation) ---
RCA_LLM_PROVIDER=none                    # none | anthropic | openai_compatible
RCA_LLM_MODEL=                           # required when provider != none
# RCA_LLM_BASE_URL=                      # optional override / OpenAI-compatible server
RCA_LLM_TIMEOUT_S=30
RCA_LLM_MAX_RETRIES=2
RCA_LLM_OUTPUT_RETRIES=1
RCA_LLM_MAX_TOKENS=1500
ANTHROPIC_API_KEY=your-key-here          # used only if provider=anthropic
OPENAI_API_KEY=your-key-here             # used only if provider=openai_compatible

# --- audit / auth (Module D integration points) ---
RCA_AUDIT_SINK=jsonl                     # jsonl | none (none = development only)
RCA_AUDIT_PATH=data/audit/rca_audit.jsonl
RCA_AUDIT_FAIL_MODE=fail_closed          # fail_closed | fail_open
RCA_AUTH_MODE=none                       # none | static_api_key (stop-gap; Module D should supply real auth)
RCA_API_KEY=your-shared-secret-here

# Copy to .env and fill in. NEVER commit .env.
# All values below are PLACEHOLDERS.

QGENAI_ENVIRONMENT=development          # development | test | production
QGENAI_DEBUG=false

# REQUIRED. Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
QGENAI_JWT_SECRET_KEY=replace-with-a-long-random-value
QGENAI_ACCESS_TOKEN_EXPIRE_MINUTES=30

# Optional but recommended: key for signing audit checkpoints (keep a copy off this machine)
QGENAI_AUDIT_CHECKPOINT_KEY=replace-with-another-long-random-value

# Database (default: storage/qgenai.db). PostgreSQL example:
# QGENAI_DATABASE_URL=postgresql+psycopg://qgenai:CHANGE_ME@localhost:5432/qgenai
# QGENAI_DATABASE_URL=sqlite:///./storage/qgenai.db

# Comma-separated list of browser origins allowed to call the API
QGENAI_CORS_ORIGINS=http://localhost:8501

# Login throttling (per client IP + username)
QGENAI_LOGIN_MAX_ATTEMPTS=5
QGENAI_LOGIN_WINDOW_SECONDS=300

# Uploads
QGENAI_MAX_UPLOAD_MB=10
QGENAI_STORE_ORIGINAL_IMAGES=false

# Model (file name inside ./models). If the file does not exist, the system runs in
# NO-MODEL mode: inspections are routed to REVIEW and no detections are produced.
QGENAI_MODEL_WEIGHTS=defect_model.pt
QGENAI_MODEL_VERSION=unversioned
QGENAI_INFERENCE_DEVICE=cpu             # cpu | 0 (CUDA GPU) | mps (Apple)
QGENAI_INFERENCE_IMAGE_SIZE=640

# Only for `python -m scripts.create_admin` (otherwise you are prompted). Do not leave
# a real password in this file after setup.
# QGENAI_ADMIN_USERNAME=
# QGENAI_ADMIN_PASSWORD=

# Frontend -> backend URL (used by Streamlit)
QGENAI_API_URL=http://127.0.0.1:8000
